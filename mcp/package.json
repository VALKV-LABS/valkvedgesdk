{
  "name": "@valkvlabs/edgekv-mcp",
  "version": "0.1.0",
  "description": "MCP server for ValkvEdgeKV: lets an AI agent keep memory in a database, encrypted with a key the service never sees",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VALKV-LABS/valkvedgesdk.git",
    "directory": "mcp"
  },
  "type": "module",
  "bin": {
    "edgekv-mcp": "./dist/main.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/server.test.ts test/config.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@valkvlabs/edgekv": "file:../typescript",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
